// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output   = "../app/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum FuelType {
  GASOLINE_95
  GASOLINE_98
  DIESEL
  DIESEL_PREMIUM
  LPG
  ELECTRIC
}

enum PriceSource {
  ANPC
  OPERATOR
  USER
  IMPORT
}

enum UserRole {
  USER
  ADMIN
}

enum ReportStatus {
  PENDING
  APPROVED
  REJECTED
}

model User {
  id        String   @id @default(cuid())
  email     String   @unique
  name      String?
  image     String?
  role      UserRole @default(USER)

  favorites FavoriteStation[]
  alerts    PriceAlert[]
  reports   PriceReport[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Brand {
  id        String    @id @default(cuid())
  name      String    @unique
  logo      String?

  stations  Station[]

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
}

model Station {
  id         String   @id @default(cuid())
  externalId String   @unique
  name       String
  brandId    String?

  address    String?
  city       String?
  county     String?
  postalCode String?

  latitude   Decimal  @db.Decimal(10, 7)
  longitude  Decimal  @db.Decimal(10, 7)

  brand      Brand?   @relation(fields: [brandId], references: [id])

  prices     FuelPrice[]
  favorites  FavoriteStation[]
  reports    PriceReport[]
  alerts     PriceAlert[]

  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([latitude, longitude])
  @@index([longitude])
  @@index([city])
  @@index([county])
  @@index([brandId])
}

model FuelPrice {
  id         String     @id @default(cuid())
  stationId  String
  station    Station    @relation(fields: [stationId], references: [id], onDelete: Cascade)

  fuelType   FuelType
  price      Decimal    @db.Decimal(6, 3)
  source     PriceSource
  observedAt DateTime
  createdAt  DateTime   @default(now())

  @@unique([stationId, fuelType, observedAt])

  @@index([stationId, fuelType])
  @@index([fuelType, observedAt])
  @@index([observedAt])
}

model ExchangeRate {
  id        String   @id @default(cuid())
  currency  String
  rate      Decimal  @db.Decimal(12, 6)
  date      DateTime
  createdAt DateTime @default(now())

  @@unique([currency, date])
  @@index([currency])
  @@index([date])
}

model FavoriteStation {
  id        String  @id @default(cuid())
  userId    String
  stationId String

  user      User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  station   Station @relation(fields: [stationId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@unique([userId, stationId])
}

model PriceAlert {
  id          String    @id @default(cuid())
  userId      String
  stationId   String?

  fuelType    FuelType
  targetPrice Decimal   @db.Decimal(6, 3)
  active      Boolean   @default(true)

  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  station     Station?  @relation(fields: [stationId], references: [id], onDelete: Cascade)

  createdAt   DateTime  @default(now())
}

model PriceReport {
  id         String       @id @default(cuid())
  userId     String
  stationId  String

  fuelType   FuelType
  price      Decimal      @db.Decimal(6, 3)
  status     ReportStatus @default(PENDING)
  photoUrl   String?

  user       User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  station    Station      @relation(fields: [stationId], references: [id], onDelete: Cascade)

  createdAt  DateTime     @default(now())
}